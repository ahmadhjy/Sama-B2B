# PRIVATE CONFIGURATION. Copy to .env; never add .env to GitHub.
# Run python deploy/configure.py --local to generate local secrets automatically.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DATA_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_URL=http://127.0.0.1:8000

# Use a SEPARATE database for HelloSama. Leave blank for local SQLite development.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=prefer

# Same integration secret goes into accounting as HELLOSAMA_SHARED_SECRET.
ACCOUNTING_BASE_URL=
ACCOUNTING_SHARED_SECRET=

# Paste your replacement OpenAI API key HERE, between the quotes if needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_ENABLED=False
AI_MONTHLY_LIMIT_USD=20

# IONOS mailbox password, NOT the main IONOS account password.
EMAIL_HOST_USER=info@hellosama.com
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.ionos.com
EMAIL_PORT=587
EMAIL_ENABLED=False
BUSINESS_EMAIL=info@hellosama.com
IMAP_HOST=imap.ionos.com
IMAP_ENABLED=False

# Broadnet GW3N. Credentials remain server-side; approved sender ID is required.
SMS_ENABLED=False
SMS_BASE_URL=http://smppa3.broadnet.me:8080/websmpp
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=
# The supplied provider endpoint is HTTP. Prefer a provider-confirmed HTTPS endpoint.
SMS_ALLOW_HTTP=False

# Keep enabled while testing the temporary PythonAnywhere subdomain.
# Push delivery is suppressed in test mode; email/SMS use these explicit allowlists.
NOTIFICATION_TEST_MODE=True
NOTIFICATION_TEST_EMAILS=info@hellosama.com
NOTIFICATION_TEST_PHONES=

# Generated by deploy/configure.py; no paid push provider needed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ALLOW_SELF_APPROVAL=True

# One-command deployment: exact WSGI file shown in PythonAnywhere's Web tab.
PA_WSGI_FILE=
# To use a different virtualenv, set VENV_PATH in the shell/task environment.
